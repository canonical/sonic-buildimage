From 74b79c0bca8b4a6e116be9419232e1718b3d2a8b Mon Sep 17 00:00:00 2001
From: Sheldon Qi <sheldon.qi@canonical.com>
Date: Thu, 12 Nov 2026 10:40:18 +0000
Subject: [PATCH] [vm_set] Start aarch64 vs DUTs with a virt machine domain

Test-harness change for running vms-kvm testbeds on an arm64 server; local only.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ansible/roles/vm_set/tasks/start_sonic_vm.yml |  2 +-
 ansible/roles/vm_set/tasks/stop_sonic_vm.yml  |  9 ++-
 .../vm_set/templates/sonic_aarch64.xml.j2     | 55 +++++++++++++++++++
 3 files changed, 62 insertions(+), 4 deletions(-)
 create mode 100644 ansible/roles/vm_set/templates/sonic_aarch64.xml.j2

diff --git a/ansible/roles/vm_set/tasks/start_sonic_vm.yml b/ansible/roles/vm_set/tasks/start_sonic_vm.yml
index 0b792ad..baabc72 100644
--- a/ansible/roles/vm_set/tasks/start_sonic_vm.yml
+++ b/ansible/roles/vm_set/tasks/start_sonic_vm.yml
@@ -72,7 +72,7 @@
 - name: Define SONiC vm {{ dut_name }}
   virt: name={{ dut_name }}
         command=define
-        xml="{{ lookup('template', 'templates/sonic.xml.j2') }}"
+        xml="{{ lookup('template', 'templates/sonic_aarch64.xml.j2' if ansible_architecture == 'aarch64' else 'templates/sonic.xml.j2') }}"
         uri=qemu:///system
   when: dut_name not in vm_list_defined.list_vms
   become: yes
diff --git a/ansible/roles/vm_set/tasks/stop_sonic_vm.yml b/ansible/roles/vm_set/tasks/stop_sonic_vm.yml
index 742fd44..3259e0b 100644
--- a/ansible/roles/vm_set/tasks/stop_sonic_vm.yml
+++ b/ansible/roles/vm_set/tasks/stop_sonic_vm.yml
@@ -13,9 +13,12 @@
   become: yes
 
 - name: Undefine vm {{ dut_name }}
-  virt: name={{ dut_name }}
-        command=undefine
-        uri=qemu:///system
+  virt:
+    name: "{{ dut_name }}"
+    command: undefine
+    # an aarch64 domain has UEFI NVRAM, and libvirt refuses to undefine it without this flag
+    flags: "{{ ['nvram'] if ansible_architecture == 'aarch64' else omit }}"
+    uri: qemu:///system
   when: dut_name in vm_list_defined.list_vms
   become: yes
 
diff --git a/ansible/roles/vm_set/templates/sonic_aarch64.xml.j2 b/ansible/roles/vm_set/templates/sonic_aarch64.xml.j2
new file mode 100644
index 0000000..42f92cd
--- /dev/null
+++ b/ansible/roles/vm_set/templates/sonic_aarch64.xml.j2
@@ -0,0 +1,55 @@
+<domain type='kvm'>
+  <name>{{ dut_name }}</name>
+  <memory unit='GiB'>6</memory>
+  <currentMemory unit='GiB'>6</currentMemory>
+  <vcpu placement='static'>4</vcpu>
+  <cpu mode='host-passthrough' check='none'>
+    <topology sockets='1' dies='1' cores='4' threads='1'/>
+  </cpu>
+  <resource>
+    <partition>/machine</partition>
+  </resource>
+  <os>
+    <type arch='aarch64' machine='virt'>hvm</type>
+    <loader readonly='yes' type='pflash'>{{ vm_aarch64_uefi_code | default('/usr/share/AAVMF/AAVMF_CODE.no-secboot.fd') }}</loader>
+    <nvram template='{{ vm_aarch64_uefi_vars | default('/usr/share/AAVMF/AAVMF_VARS.fd') }}'/>
+    <boot dev='hd'/>
+  </os>
+  <features>
+    <acpi/>
+    <gic version='3'/>
+  </features>
+  <clock offset='utc'/>
+  <on_poweroff>destroy</on_poweroff>
+  <on_reboot>restart</on_reboot>
+  <on_crash>restart</on_crash>
+  <devices>
+    <emulator>/usr/bin/qemu-system-aarch64</emulator>
+    <disk type='file' device='disk'>
+      <driver name='qemu' type='qcow2' cache='writeback'/>
+      <source file='{{ disk_image }}'/>
+      <target bus='virtio' dev='vda'/>
+    </disk>
+    <serial type='tcp'>
+      <source host='127.0.0.1' mode='bind' service='{{ serial_port }}'/>
+      <target port='0'/>
+      <protocol type='telnet'/>
+      <log file='/var/log/libvirt/qemu/boot-serial-{{ dut_name }}.log' append='on'/>
+    </serial>
+{% for i in range(port_alias|length + 1) %}
+    <interface type='ethernet'>
+      <target dev='{{ dut_name }}-{{ i }}'/>
+      <model type='{{ vm_aarch64_nic_model | default('e1000') }}'/>
+{% if i > 0 %}
+      <mtu size='{{ fp_mtu_size }}'/>
+{% endif %}
+    </interface>
+{% endfor %}
+    <controller type='usb' index='0' model='qemu-xhci'/>
+    <memballoon model='virtio'/>
+    <watchdog model='i6300esb'/>
+  </devices>
+{% if vm_seclabel | default(true) | bool %}
+  <seclabel type='dynamic' model='apparmor' relabel='yes'/>
+{% endif %}
+</domain>
-- 
2.53.0

