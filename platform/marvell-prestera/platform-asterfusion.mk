# Asterfusion platform modules

ASTERFUSION_PLATFORM_MODULE_VERSION = 1.0

ASTERFUSION_CX204Y_48GT_PLATFORM = sonic-platform-asterfusion-x204y-48gt_$(ASTERFUSION_PLATFORM_MODULE_VERSION)_$(CONFIGURED_ARCH).deb
$(ASTERFUSION_CX204Y_48GT_PLATFORM)_SRC_PATH = $(PLATFORM_PATH)/sonic-platform-asterfusion
$(ASTERFUSION_CX204Y_48GT_PLATFORM)_DEPENDS += $(LINUX_HEADERS) $(LINUX_HEADERS_COMMON)
$(ASTERFUSION_CX204Y_48GT_PLATFORM)_PLATFORM = arm64-asterfusion_cx204y_48gt_d-r0
SONIC_DPKG_DEBS += $(ASTERFUSION_CX204Y_48GT_PLATFORM)

# GRUB reads the dtb before first boot, so it is installed at image build, not lazily
ASTERFUSION_DTB = sonic-platform-asterfusion-dtb_$(ASTERFUSION_PLATFORM_MODULE_VERSION)_$(CONFIGURED_ARCH).deb
$(eval $(call add_extra_package,$(ASTERFUSION_CX204Y_48GT_PLATFORM),$(ASTERFUSION_DTB)))
