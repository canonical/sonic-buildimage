MPATH       := $($(MRVL_SAI_PYSTUB)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) $(PLATFORM_PATH)/mrvl-sai-pystub.mk $(PLATFORM_PATH)/mrvl-sai-pystub.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(MPATH))

$(MRVL_SAI_PYSTUB)_CACHE_MODE  := GIT_CONTENT_SHA
$(MRVL_SAI_PYSTUB)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(MRVL_SAI_PYSTUB)_DEP_FILES   := $(DEP_FILES)
