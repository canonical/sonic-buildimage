#!/bin/sh
#
# Render /etc/resolv.conf from the DHCP lease.
#
# dhclient-script(8) hands DNS data to /sbin/resolvconf whenever that command is
# executable. On Ubuntu it is a symlink to resolvectl, and resolvectl(1) states
# that its resolvconf compatibility mode "will only update /etc/resolv.conf with
# servers added with this command when /etc/resolv.conf is a symlink to
# /run/systemd/resolve/resolv.conf, and not a static file" — SONiC keeps it a
# static file, so the leased servers would never reach the glibc resolver.
# Override make_resolv_conf() to write the file directly instead.
#
# Static DNS configuration takes precedence: resolv-config.sh leaves a marker
# while it is in effect and this hook then keeps its hands off.

RESOLV_CONF=/etc/resolv.conf
RESOLV_CONF_HEAD=/usr/share/sonic/templates/resolv.conf.head
STATIC_MARKER=/run/sonic-resolv-static
UPDATE_CONTAINERS=/usr/bin/update-containers

make_resolv_conf() {
    [ -e "${STATIC_MARKER}" ] && return 0

    search=
    servers=

    if [ -n "$new_domain_search" ]; then
        search="$new_domain_search"
    elif [ -n "$new_domain_name" ]; then
        search="$new_domain_name"
    elif [ -n "$new_dhcp6_domain_search" ]; then
        search="$new_dhcp6_domain_search"
    fi

    for ns in $new_domain_name_servers; do
        servers="${servers}nameserver ${ns}
"
    done
    for ns in $new_dhcp6_name_servers; do
        # Scoped link-local servers need the interface appended.
        case "$ns" in
            fe80::*) servers="${servers}nameserver ${ns}%${interface}
" ;;
            *)       servers="${servers}nameserver ${ns}
" ;;
        esac
    done

    # Nothing leased: leave the current file alone rather than emptying it.
    [ -z "$servers" ] && [ -z "$search" ] && return 0

    tmp="${RESOLV_CONF}.dhclient-new.$$"
    cat "${RESOLV_CONF_HEAD}" > "${tmp}" 2>/dev/null
    [ -n "$search" ] && echo "search ${search}" >> "${tmp}"
    printf '%s' "${servers}" >> "${tmp}"
    chmod 644 "${tmp}"
    mv -f "${tmp}" "${RESOLV_CONF}"

    [ -x "${UPDATE_CONTAINERS}" ] && "${UPDATE_CONTAINERS}" &
    return 0
}
