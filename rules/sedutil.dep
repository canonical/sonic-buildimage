# resolute: sedutil is an ONLINE_DEB with no in-repo source to hash,
# so no SPATH / git ls-files.

DEP_FILES := $(SONIC_COMMON_FILES_LIST) rules/sedutil.mk rules/sedutil.dep
DEP_FILES += $(SONIC_COMMON_BASE_FILES_LIST)

$(SEDUTIL)_CACHE_MODE := GIT_CONTENT_SHA
$(SEDUTIL)_DEP_FLAGS := $(SONIC_COMMON_FLAGS_LIST)
$(SEDUTIL)_DEP_FILES := $(DEP_FILES)
